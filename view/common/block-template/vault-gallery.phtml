<div class="vault-gallery-engine">
    <?php
    $firstItem = $this->resources[0];
    $firstMedia = $firstItem->primaryMedia();
    ?>

    <!-- Stage -->
    <div id="vault-stage" class="vault-stage">
        <button id="vault-prev" class="vault-arrow" aria-label="Previous image">‹</button>
        <div class="stage-viewport" id="vault-trigger-lightbox">
            <img id="vault-main-display"
                src="<?php echo $this->escapeHtml($firstMedia->thumbnailUrl('large')); ?>"
                alt="<?php echo $this->escapeHtml($firstItem->displayTitle()); ?>">
        </div>
        <div class="vault-label-plaque">
            <h2 id="vault-title"><?php echo $this->escapeHtml($firstItem->displayTitle()); ?></h2>
            <div id="vault-description" class="vault-description-text">
                <?php echo $this->escapeHtml($firstItem->displayDescription()); ?>
            </div>
        </div>
        <button id="vault-next" class="vault-arrow" aria-label="Next image">›</button>
    </div>

    <!-- Control Panel -->
    <div class="vault-control-panel">
        <div class="vault-vitrine-tray">
            <button id="vitrine-prev" class="vitrine-arrow" aria-label="Previous thumbnails">‹</button>
            <div class="vitrine-scroll">
                <?php foreach ($this->resources as $index => $resource): ?>
                <?php $media = $resource->primaryMedia(); ?>
                <div class="vitrine-item <?php echo $index === 0 ? 'active' : ''; ?>"
                    data-img="<?php echo $this->escapeHtml($media->thumbnailUrl('large')); ?>"
                    data-title="<?php echo $this->escapeHtml($resource->displayTitle()); ?>"
                    data-desc="<?php echo $this->escapeHtml($resource->displayDescription()); ?>">
                    <img src="<?php echo $this->escapeHtml($media->thumbnailUrl('square')); ?>" alt="">
                </div>
                <?php endforeach; ?>
            </div>
            <button id="vitrine-next" class="vitrine-arrow" aria-label="Next thumbnails">›</button>
        </div>
    </div>

    <!-- Lightbox Modal -->
    <div id="vault-lightbox">
        <button id="vault-lightbox-close" aria-label="Close">×</button>
        <img id="lightbox-img" src="" alt="Full view">
    </div>
</div>

<script>
(function() {
    const items = document.querySelectorAll('.vitrine-item');
    const display = document.getElementById('vault-main-display');
    const title = document.getElementById('vault-title');
    const desc = document.getElementById('vault-description');
    const lightbox = document.getElementById('vault-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const tray = document.querySelector('.vitrine-scroll');
    let currentIndex = 0;

    function updateVault(index) {
        items.forEach(i => i.classList.remove('active'));
        const selected = items[index];
        selected.classList.add('active');
        currentIndex = index;

        display.style.opacity = '0';
        setTimeout(() => {
            display.src = selected.dataset.img;
            title.innerText = selected.dataset.title;
            desc.innerHTML = selected.dataset.desc;
            display.style.opacity = '1';
        }, 200);

        const trayWidth = tray.offsetWidth;
        const itemOffset = selected.offsetLeft;
        const itemWidth = selected.offsetWidth;

        tray.scrollTo({
            left: itemOffset - (trayWidth / 2) + (itemWidth / 2),
            behavior: 'smooth'
        });
    }

    items.forEach((item, idx) => {
        item.addEventListener('click', () => updateVault(idx));
    });

    document.getElementById('vault-prev').addEventListener('click', () => {
        let newIdx = currentIndex === 0 ? items.length - 1 : currentIndex - 1;
        updateVault(newIdx);
    });

    document.getElementById('vault-next').addEventListener('click', () => {
        let newIdx = currentIndex === items.length - 1 ? 0 : currentIndex + 1;
        updateVault(newIdx);
    });

    const closeLightbox = () => {
        lightbox.classList.remove('open');
        document.body.classList.remove('lightbox-active');
    };

    document.getElementById('vault-trigger-lightbox').addEventListener('click', () => {
        lightboxImg.src = display.src;
        lightbox.classList.add('open');
        document.body.classList.add('lightbox-active');
    });

    document.getElementById('vault-lightbox-close').addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
        if (e.target !== lightboxImg) closeLightbox();
    });

    // Vitrine scroll arrows
    const vitrinePrev = document.getElementById('vitrine-prev');
    const vitrineNext = document.getElementById('vitrine-next');
    const vitrineScroll = document.querySelector('.vitrine-scroll');

    if (vitrinePrev && vitrineNext && vitrineScroll) {
        vitrinePrev.addEventListener('click', () => {
            vitrineScroll.scrollBy({ left: -150, behavior: 'smooth' });
        });
        vitrineNext.addEventListener('click', () => {
            vitrineScroll.scrollBy({ left: 150, behavior: 'smooth' });
        });
    }
})();
</script>