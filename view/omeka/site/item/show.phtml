<?php
$translate = $this->plugin('translate');
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource show');
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
?>
<?php echo $this->pageTitle($item->displayTitle(null, $valueLang), 2); ?>
<h3><?php echo $translate('Item'); ?></h3>
<?php $this->trigger('view.show.before'); ?>

<?php
// Map media IDs and original asset paths to large thumbnail URLs
$urlMap = [];
$hasImage = false;
foreach ($item->media() as $media) {
    if (strpos($media->mediaType(), 'image') !== false) {
        $hasImage = true;
    }
    $largeThumb = $media->thumbnailUrl('large');
    if ($largeThumb) {
        $urlMap['/media/' . $media->id()] = $largeThumb;
        $originalUrl = $media->originalUrl();
        if ($originalUrl) {
            $parseUrl = parse_url($originalUrl, PHP_URL_PATH);
            if ($parseUrl) {
                $urlMap[$parseUrl] = $largeThumb;
            }
        }
    }
}

// Intercept the blocks markup and rewrite blocked links to large thumbnails
ob_start();
echo $this->resourcePageBlocks($item)->getBlocks();
$blocksHtml = ob_get_clean();

if (!empty($urlMap) && class_exists('DOMDocument')) {
    $doc = new DOMDocument();
    libxml_use_internal_errors(true);
    $doc->loadHTML(mb_convert_encoding($blocksHtml, 'HTML-ENTITIES', 'UTF-8'), LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);
    libxml_clear_errors();

    $anchors = $doc->getElementsByTagName('a');
    $modified = false;

    foreach ($anchors as $anchor) {
        $href = $anchor->getAttribute('href');
        if ($href) {
            $path = parse_url($href, PHP_URL_PATH);
            foreach ($urlMap as $blockedPath => $safeUrl) {
                if ($path === $blockedPath || strpos($path, $blockedPath) !== false) {
                    $anchor->setAttribute('href', $safeUrl);
                    $anchor->setAttribute('target', '_blank');
                    $modified = true;
                    break;
                }
            }
        }
    }
    if ($modified) {
        $blocksHtml = $doc->saveHTML();
    }
}

echo $blocksHtml;
?>

<?php if ($hasImage): ?>
    <div class="full-res-notice">
        <p>Full-resolution scans are available upon request.</p>
        <a href="mailto:admin@thefiftyacres.com?subject=Full-res request for Item: <?php echo $this->escapeHtml($item->displayTitle()); ?>">Request full-res version</a>
    </div>
<?php endif; ?>

<?php $this->trigger('view.show.after'); ?>