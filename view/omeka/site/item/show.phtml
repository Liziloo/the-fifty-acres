<?php
$translate = $this->plugin('translate');
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource show');
$this->layout()->setVariable('isItemPage', true);

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$adminEmail = $this->themeSetting('admin_email', 'your-email@example.com');

$urlMap = [];
foreach ($item->media() as $media) {
    $largeThumb = $media->thumbnailUrl('large');
    if ($largeThumb) {
        $urlMap['/media/' . $media->id()] = $largeThumb;
        $originalUrl = $media->originalUrl();
        if ($originalUrl) {
            $path = parse_url($originalUrl, PHP_URL_PATH);
            if ($path) { $urlMap[$path] = $largeThumb; }
        }
    }
}
?>

<?php echo $this->pageTitle($item->displayTitle(null, $valueLang), 2); ?>

<?php $this->trigger('view.show.before'); ?>

<div class="item-resource-layout">
    <?php
    $allBlocksHtml = $this->resourcePageBlocks($item)->getBlocks();

    // Safely split the blocks. The first block is the photo, the rest is data.
    // We split after the first closing </div> of a top-level block.
    $blocks = preg_split('/(<\/div>)/', $allBlocksHtml, 2, PREG_SPLIT_DELIM_CAPTURE);

    $photoHtml = isset($blocks[0]) && isset($blocks[1]) ? $blocks[0] . $blocks[1] : '';
    $dataHtml = isset($blocks[2]) ? $blocks[2] : '';

    // Update media links for lightbox behavior in the metadata
    if (!empty($urlMap)) {
        foreach ($urlMap as $path => $thumb) {
            $dataHtml = str_replace('href="' . $path . '"', 'href="' . $thumb . '" target="_blank"', $dataHtml);
        }
    }

    echo '<div class="primary-photo-zone">' . $photoHtml . '</div>';
    echo '<div class="archival-card-zone">' . $dataHtml . '</div>';
    ?>
</div>

<?php if (count($item->media()) > 0): ?>
    <div class="full-res-notice">
        <p>Full-resolution scans are available upon request.</p>
        <a href="mailto:<?php echo $adminEmail; ?>?subject=Full-res request for Item: <?php echo $this->escapeHtml($item->displayTitle()); ?>">Request full-res version</a>
    </div>
<?php endif; ?>

<?php $this->trigger('view.show.after'); ?>