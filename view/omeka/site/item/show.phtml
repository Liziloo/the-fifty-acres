<?php
$translate = $this->plugin('translate');
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource show');
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
?>
<?php echo $this->pageTitle($item->displayTitle(null, $valueLang), 2); ?>
<h3><?php echo $translate('Item'); ?></h3>
<?php $this->trigger('view.show.before'); ?>
<?php echo $this->resourcePageBlocks($item)->getBlocks(); ?>

<?php
// Check if any attached media is an image
$hasImage = false;
foreach ($item->media() as $media) {
    if (strpos($media->mediaType(), 'image') !== false) {
        $hasImage = true;
        break;
    }
}
?>

<?php if ($hasImage): ?>
    <div class="full-res-notice">
        <p>Full-resolution scans are available upon request.</p>
        <a href="mailto:your-email@example.com?subject=Full-res request for Item: <?php echo $this->escapeHtml($item->displayTitle()); ?>">Request full-res version</a>
    </div>
<?php endif; ?>

<?php $this->trigger('view.show.after'); ?>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // Map media IDs to their respective large thumbnail URLs
    const mediaThumbnails = {
        <?php foreach ($item->media() as $m): ?>
            "<?php echo $m->id(); ?>": "<?php echo $this->escapeJs($m->thumbnailUrl('large')); ?>",
        <?php endforeach; ?>
    };

    // Intercept media page links and point them directly to the large thumbnail asset
    document.querySelectorAll('a').forEach(link => {
        const href = link.getAttribute('href');
        if (href && href.includes('/media/')) {
            const parts = href.split('/');
            const mediaId = parts[parts.length - 1].split('?')[0];

            if (mediaThumbnails[mediaId]) {
                link.setAttribute('href', mediaThumbnails[mediaId]);
                link.setAttribute('target', '_blank'); // Opens the large thumbnail in a safe tab
            }
        }
    });
});
</script>