<?php
$translate = $this->plugin('translate');
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource show');
$this->layout()->setVariable('isItemPage', true);

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
$adminEmail = $this->themeSetting('admin_email', 'your-email@example.com');

// 1. Gather all file thumbnail paths for the layout
$urlMap = [];
foreach ($item->media() as $media) {
    $largeThumb = $media->thumbnailUrl('large');
    if ($largeThumb) {
        $urlMap['/media/' . $media->id()] = $largeThumb;
        $originalUrl = $media->originalUrl();
        if ($originalUrl) {
            $path = parse_url($originalUrl, PHP_URL_PATH);
            if ($path) { $urlMap[$path] = $largeThumb; }
        }
    }
}

// 2. Capture linked resources
$api = $this->api();
$linkedResources = [];
try {
    $response = $api->search('items', ['property' => [['property' => '', 'type' => 'res', 'text' => $item->id()]]]);
    $linkedResources = $response->getContent();
} catch (\Exception $e) {}

// 3. Logic for the "Actual" Back Button Fallback
$itemSets = $item->itemSets();
$fallbackUrl = !empty($itemSets) ? $itemSets[0]->url() : $this->url('site/resource', ['controller' => 'item', 'action' => 'browse'], true);
?>

<?php echo $this->pageTitle($item->displayTitle(null, $valueLang), 2); ?>

<!-- ACTUAL BACK BUTTON -->
<a href="<?php echo $fallbackUrl; ?>"
   class="smart-back-button"
   onclick="if(document.referrer.indexOf(window.location.host) !== -1) { history.back(); return false; }">
    <span class="back-arrow">&larr;</span> <?php echo $this->translate('Back'); ?>
</a>

<?php $this->trigger('view.show.before'); ?>

<div class="item-resource-layout">
    <div class="primary-photo-zone">
        <?php if ($primaryMedia = $item->primaryMedia()): ?>
            <div class="media-render">
                <img src="<?php echo $this->escapeHtml($primaryMedia->thumbnailUrl('large') ?: $primaryMedia->source()); ?>" alt="<?php echo $this->escapeHtml($item->displayTitle()); ?>">
            </div>
        <?php endif; ?>
    </div>

    <div class="archival-card-zone">
        <dl class="metadata-property-list">
            <?php foreach ($item->values() as $term => $propertyData): ?>
                <div class="property">
                    <dt><?php echo $this->escapeHtml($propertyData['property']->label()); ?></dt>
                    <dd>
                        <?php foreach ($propertyData['values'] as $value): ?>
                            <span class="value-literal">
                                <?php
                                $valueHtml = $value->asHtml();
                                if (!empty($urlMap)) {
                                    foreach ($urlMap as $path => $thumb) {
                                        $valueHtml = str_replace('href="' . $path . '"', 'href="' . $thumb . '" target="_blank"', $valueHtml);
                                    }
                                }
                                echo $valueHtml;
                                ?>
                            </span>
                        <?php endforeach; ?>
                    </dd>
                </div>
            <?php endforeach; ?>

            <?php if (!empty($linkedResources)): ?>
                <div class="property linked-references-row">
                    <dt>Referenced By</dt>
                    <dd>
                        <?php foreach ($linkedResources as $linkedItem): ?>
                            <span class="value-literal">
                                <a href="<?php echo $this->escapeHtml($linkedItem->url()); ?>">
                                    <?php echo $this->escapeHtml($linkedItem->displayTitle(null, $valueLang)); ?>
                                </a>
                            </span>
                        <?php endforeach; ?>
                    </dd>
                </div>
            <?php endif; ?>
        </dl>
    </div>
</div>

<?php if (count($item->media()) > 0): ?>
    <div class="full-res-notice">
        <p>From the Fifty Acres Archive. High-resolution files available upon request for non-commercial use. Republication or online distribution requires explicit permission.</p>
        <a href="mailto:<?php echo $adminEmail; ?>?subject=Full-res request for Item: <?php echo $this->escapeHtml($item->displayTitle()); ?>">Request full-res version</a>
    </div>
<?php endif; ?>

<?php $this->trigger('view.show.after'); ?>